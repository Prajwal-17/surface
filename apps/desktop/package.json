{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Surface local-first job-review desktop app",
  "author": {
    "name": "Surface",
    "email": "desktop@surface.local"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && electron-builder --linux AppImage deb",
    "package:appimage": "node scripts/build.mjs && electron-builder --linux AppImage",
    "package:deb": "node scripts/build.mjs && electron-builder --linux deb",
    "package:ubuntu": "node scripts/build.mjs && electron-builder --linux AppImage deb",
    "package:dir": "node scripts/build.mjs && electron-builder --linux dir",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json ."
  },
  "devDependencies": {
    "@surface/typescript-config": "workspace:*",
    "@types/node": "26.3.0",
    "electron": "latest",
    "electron-builder": "latest",
    "esbuild": "latest",
    "typescript": "npm:typescript@6.0.2"
  },
  "build": {
    "appId": "dev.surface.desktop",
    "productName": "Surface",
    "artifactName": "Surface-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/web",
        "to": "web"
      },
      {
        "from": "build/backend",
        "to": "backend"
      },
      {
        "from": "build/crawler",
        "to": "crawler"
      },
      {
        "from": "build/playwright",
        "to": "playwright"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "surface",
      "icon": "resources/icon.png",
      "synopsis": "Local-first job-review workspace",
      "description": "Surface finds, explains and tracks jobs that fit your profile. The desktop app keeps its SQLite database, snapshots and evidence on your machine.",
      "desktop": {
        "entry": {
          "StartupWMClass": "surface"
        }
      },
      "maintainer": "Surface <desktop@surface.local>",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "surface",
      "compression": "xz"
    },
    "extraMetadata": {
      "desktopName": "surface.desktop"
    }
  },
  "homepage": "https://github.com/Prajwal-17/surface"
}
