{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "APP_ENV=development NODE_ENV=development node --import tsx --watch src/index.ts",
    "start": "APP_ENV=production NODE_ENV=production node dist/index.mjs",
    "build": "node scripts/build.mjs",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test": "bun run scripts/test.ts",
    "verify:sqlite": "node --import tsx scripts/verify-sqlite.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.92",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "latest",
    "@surface/contracts": "workspace:*",
    "ai": "7.0.173",
    "drizzle-orm": "latest",
    "fast-xml-parser": "latest",
    "hono": "^4.13.5",
    "linkedom": "^0.18.13",
    "sanitize-html": "^2.17.7",
    "unpdf": "1.8.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@surface/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "26.3.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "latest",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "npm:typescript@6.0.2"
  }
}
