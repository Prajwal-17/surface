PORT=4000
SOURCE_TIMEOUT_MS=12000
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# Company research services (local development)
SEARXNG_BASE_URL=http://127.0.0.1:8080
CRAWLER_BASE_URL=http://127.0.0.1:4100

# Local processes choose the URL matching APP_ENV. Encode special characters in credentials.
PRODUCTION_DATABASE_URL=postgresql://surface:CHANGE_ME@127.0.0.1:5432/surface-data
DEVELOPMENT_DATABASE_URL=postgresql://surface:CHANGE_ME@127.0.0.1:5432/surface-dev-data
# DATABASE_URL is an optional explicit override; never use production for development/tests.
# DATA_DIR stores snapshots and the session signing key (defaults to data/ or data/development/).
