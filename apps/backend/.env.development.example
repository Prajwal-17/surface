# Optional. If unset, development login accepts any valid email because its data
# is stored separately from production. Set this to test a fixed owner email.
AUTH_EMAIL=

# Optional. A local key is generated in DATA_DIR otherwise.
AUTH_SECRET=

# Keep false for local HTTP. Set true when using HTTPS.
AUTH_COOKIE_SECURE=false

# Local processes choose the URL matching APP_ENV. Encode special characters in credentials.
PRODUCTION_DATABASE_URL=postgresql://surface:CHANGE_ME@127.0.0.1:5432/surface-data
DEVELOPMENT_DATABASE_URL=postgresql://surface:CHANGE_ME@127.0.0.1:5432/surface-dev-data
# DATABASE_URL is an optional explicit override; never use production for development/tests.
# DATA_DIR stores snapshots and the session signing key (defaults to data/ or data/development/).

# Optional AI provider settings. Without OPENCODE_GO_API_KEY, AI features stay
# unavailable while the rest of the app starts normally.
AI_PROVIDER=opencode-go
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_MODEL=deepseek-v4.1-flash
OPENCODE_GO_API_KEY=
