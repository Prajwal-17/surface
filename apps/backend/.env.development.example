# Optional. If unset, development login accepts any valid email because its data
# is stored separately from production. Set this to test a fixed owner email.
AUTH_EMAIL=

# Optional. A local key is generated in DATA_DIR otherwise.
AUTH_SECRET=

# Keep false for local HTTP. Set true when using HTTPS.
AUTH_COOKIE_SECURE=false

# Optional SQLite override. Standalone defaults use surface.sqlite3 inside DATA_DIR.
# SQLITE_DATABASE_FILE=/absolute/path/to/surface.sqlite3

# Optional AI provider settings. Without OPENCODE_GO_API_KEY, AI features stay
# unavailable while the rest of the app starts normally.
AI_PROVIDER=opencode-go
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_MODEL=deepseek-v4.1-flash
OPENCODE_GO_API_KEY=
