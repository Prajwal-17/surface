{
  "name": "surface",
  "private": true,
  "scripts": {
    "build": "bun --filter './apps/*' build",
    "dev": "bun run --parallel --filter './apps/*' dev",
    "lint": "bun --filter './apps/*' lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "bun --filter './apps/*' check-types",
    "db:generate": "bun --cwd apps/backend db:generate",
    "db:migrate": "bun --cwd apps/backend db:migrate",
    "db:studio": "bun --cwd apps/backend db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "npm:typescript@6.0.2"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.1"
    }
  },
  "workspaces": [
    "apps/*"
  ]
}
