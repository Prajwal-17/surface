{
  "name": "surface",
  "private": true,
  "packageManager": "bun@1.4.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "bun --cwd apps/desktop dev",
    "prod": "bun run scripts/start-production.ts",
    "start": "bun run prod",
    "lint": "turbo run lint",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "desktop:build": "bun --cwd apps/desktop build",
    "desktop:build:dev": "bun --cwd apps/desktop build:dev",
    "desktop:package": "node scripts/desktop-release.mjs package",
    "desktop:package:dev": "node scripts/desktop-release.mjs package --channel development",
    "desktop:smoke": "node scripts/desktop-release.mjs smoke",
    "desktop:smoke:dev": "node scripts/desktop-release.mjs smoke --channel development",
    "release:notes": "node scripts/release-notes.mjs",
    "changelog": "node scripts/changelog.mjs",
    "db:generate": "bun --cwd apps/backend db:generate",
    "db:migrate": "bun --cwd apps/backend db:migrate",
    "verify:sqlite": "bun --cwd apps/backend verify:sqlite"
  },
  "devDependencies": {
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "npm:typescript@6.0.2"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
