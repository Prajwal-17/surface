{
  "name": "surface",
  "private": true,
  "packageManager": "bun@1.4.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --ui=tui",
    "prod": "bun run scripts/start-production.ts",
    "start": "bun run prod",
    "lint": "turbo run lint",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "db:generate": "bun --cwd apps/backend db:generate",
    "db:migrate": "bun --cwd apps/backend db:migrate",
    "db:studio": "bun --cwd apps/backend db:studio"
  },
  "devDependencies": {
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "npm:typescript@6.0.2"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
