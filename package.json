{
  "name": "surface",
  "private": true,
  "packageManager": "bun@1.4.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "bun --cwd apps/desktop dev",
    "db:studio:dev": "bun --cwd apps/backend db:studio:dev",
    "db:studio:prod": "bun --cwd apps/backend db:studio:prod",
    "lint": "turbo run lint",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "desktop:build": "bun --cwd apps/desktop build",
    "desktop:build:dev": "bun --cwd apps/desktop build:dev",
    "changelog": "node scripts/changelog.mjs",
    "desktop:package": "bun --cwd apps/desktop package",
    "desktop:package:dev": "bun --cwd apps/desktop package:dev"
  },
  "devDependencies": {
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "npm:typescript@6.0.2"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
