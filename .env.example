# Docker Compose configuration
# OpenCode Go is a hosted API; no local model gateway is required.
AI_PROVIDER=opencode-go
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_MODEL=deepseek-v4.1-flash
OPENCODE_GO_API_KEY=
FIELDWORK_DATA_DIR=./data
FIELDWORK_PROD_WEB_PORT=3001
# Keep the production crawler separate from the local development crawler on 4100.
FIELDWORK_PROD_CRAWLER_PORT=4101
TZ=Asia/Kolkata

# Restrict production login to this email, or leave empty to use the email in the saved profile.
AUTH_EMAIL=
# Optional stable signing key (minimum 32 characters); if empty, one is saved in the data volume.
AUTH_SECRET=
# Enable when serving the app over HTTPS. Local Docker Compose uses HTTP.
AUTH_COOKIE_SECURE=false

# Company research services (local development)
SEARXNG_BASE_URL=http://127.0.0.1:8080
CRAWLER_BASE_URL=http://127.0.0.1:4100

# Optional SQLite override. Standalone defaults use surface.sqlite3 inside DATA_DIR.
# SQLITE_DATABASE_FILE=/absolute/path/to/surface.sqlite3
