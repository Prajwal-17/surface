# Docker Compose configuration
OMNIROUTE_DOCKER_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
FIELDWORK_DATA_DIR=./data
FIELDWORK_PROD_WEB_PORT=3001
# Keep the production crawler separate from the local development crawler on 4100.
FIELDWORK_PROD_CRAWLER_PORT=4101
TZ=Asia/Kolkata

# Restrict production login to this email, or leave empty to use the email in the saved profile.
AUTH_EMAIL=
# Optional stable signing key (minimum 32 characters); if empty, one is saved in the data volume.
AUTH_SECRET=
# Enable when serving the app over HTTPS. Local Docker Compose uses HTTP.
AUTH_COOKIE_SECURE=false

# Company research services (local development)
SEARXNG_BASE_URL=http://127.0.0.1:8080
CRAWLER_BASE_URL=http://127.0.0.1:4100

# Local processes choose the URL matching APP_ENV. Encode special characters in credentials.
PRODUCTION_DATABASE_URL=postgresql://surface:CHANGE_ME@127.0.0.1:5432/surface-data
DEVELOPMENT_DATABASE_URL=postgresql://surface:CHANGE_ME@127.0.0.1:5432/surface-dev-data
# DATABASE_URL is an optional explicit override; never use production for development/tests.
# DATA_DIR stores snapshots and the session signing key (defaults to data/ or data/development/).
# Docker backend reaches primary-pg through its existing external network.
DOCKER_DATABASE_URL=postgresql://surface:CHANGE_ME@primary-pg:5432/surface-data
POSTGRES_NETWORK=grill-me_default
